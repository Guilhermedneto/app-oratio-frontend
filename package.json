{
  "name": "oratio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-content.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4183 --strictPort",
