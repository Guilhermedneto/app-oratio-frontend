# Copie para .env.local (nunca versione). Todas são opcionais.
# Base da API vista pelo navegador. Deixe /api (a Vercel encaminha para o Render por rewrite).
VITE_API_BASE=/api
# Chave PÚBLICA do Web Push (gere o par com: npx web-push generate-vapid-keys). A privada fica só no back.
VITE_VAPID_PUBLIC_KEY=
# Client ID do Google para "Entrar com Google"
VITE_GOOGLE_CLIENT_ID=
# Só no desenvolvimento: URL da API usada pelo proxy do Vite (padrão http://localhost:8010)
# ORATIO_API=http://localhost:8010
